# UA: Вкладення віддаються лише через admin/download.php (дубль захисту з ../.htaccess).
# EN: Attachments are served through admin/download.php only (mirrors ../.htaccess).

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
