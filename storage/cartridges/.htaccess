# UA: PDF бланків віддаються лише через cartridge-pdf.php.
# EN: Cartridge PDFs are served through cartridge-pdf.php only.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
