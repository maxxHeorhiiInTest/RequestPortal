# UA: Жодного прямого доступу до завантажених файлів — лише через admin/download.php.
# EN: No direct access to uploaded files — they are served by admin/download.php only.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Never execute anything that ends up here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
    AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
</IfModule>
